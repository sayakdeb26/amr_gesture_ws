import rclpy
from rclpy.node import Node
from std_msgs.msg import Float32MultiArray
from amr_interfaces.msg import Intent, UnknownGesture, KeypointsWindow
# Try to import the KeypointsWindow message (expected from keypoint extractor)
try:
    from amr_interfaces.msg import KeypointsWindow
except Exception:
    KeypointsWindow = None  # workspace might still be building

import onnxruntime as ort
import numpy as np
import time
from typing import Optional, Tuple

class LstmOnnxNode(Node):
    def __init__(self):
        super().__init__('lstm_onnx_node')

        # ---- parameters
        self.declare_parameter("weights_path", "")
        self.declare_parameter("normalizer_path", "")
        self.declare_parameter("labels_path", "")
        self.declare_parameter("conf_threshold", 0.80)
        self.declare_parameter("min_frames", 12)   # allow early decision
        self.declare_parameter("model_frames", 30) # training window
        self.declare_parameter("intra_threads", 3)
        self.declare_parameter("allow_stub", True)
        self.declare_parameter("background_label", "NO_GESTURE")
        self.declare_parameter("treat_background_as_unknown", True)

        self.conf_threshold = float(self.get_parameter("conf_threshold").value)
        self.min_frames     = int(self.get_parameter("min_frames").value)
        self.model_frames   = int(self.get_parameter("model_frames").value)
        self.allow_stub     = bool(self.get_parameter("allow_stub").value)

        # ---- load labels / normalizer
        self.labels = self._load_labels(self.get_parameter("labels_path").value)
        self.bg_label = self.get_parameter("background_label").value or "NO_GESTURE"
        self.bg_is_unknown = bool(self.get_parameter("treat_background_as_unknown").value)

        self.mu, self.sigma = self._load_normalizer(self.get_parameter("normalizer_path").value)

        # ---- ONNX session & input shape
        self.session: Optional[ort.InferenceSession] = None
        self.input_rank: Optional[int] = None      # 2 or 3
        self.input_shape: Optional[Tuple[Optional[int], ...]] = None  # (N,2520) or (N,T,F)
        self.frames_needed: int = self.model_frames
        self.feat_dim: Optional[int] = None        # 2520 (flat) or 84

        weights_path = self.get_parameter("weights_path").value
        try:
            if not weights_path:
                raise RuntimeError("weights_path param is empty")
            sess_opts = ort.SessionOptions()
            sess_opts.intra_op_num_threads = int(self.get_parameter("intra_threads").value)
            self.session = ort.InferenceSession(weights_path, sess_options=sess_opts, providers=["CPUExecutionProvider"])
            inp = self.session.get_inputs()[0]
            ishape = tuple(int(d) if isinstance(d, (int, np.integer)) else None for d in inp.shape)
            self.input_shape = ishape
            self.input_rank  = len(ishape)

            if self.input_rank == 2:
                # [batch, 2520] → 30*84 flattened
                self.frames_needed = self.model_frames
                self.feat_dim = 2520
                self.get_logger().info("ONNX loaded. input=x shape=['batch', 2520]")
            elif self.input_rank == 3:
                # [batch, T, F] (usually [1,30,84])
                T = ishape[1] if ishape[1] is not None else self.model_frames
                F = ishape[2] if ishape[2] is not None else 84
                self.frames_needed = T
                self.feat_dim = F
                self.get_logger().info(f"ONNX loaded. input=x shape=['batch', {T}, {F}]")
            else:
                raise RuntimeError(f"Unsupported ONNX input rank: {self.input_rank}, shape={ishape}")

        except Exception as e:
            if self.allow_stub:
                self.get_logger().warn(f"ONNX load failed ({e}); using STUB fallback")
                self.session = None
            else:
                raise

        # ---- pubs/subs (match pipeline topic names)
        self.pub_intent_raw  = self.create_publisher(Intent, '/intents_raw', 10)
        self.pub_intent_main = self.create_publisher(Intent, '/intents', 10)
        self.pub_unknown     = self.create_publisher(UnknownGesture, '/lstm/unknown', 10)

        # Primary subscription: a full keypoints window
        if KeypointsWindow is not None:
            self.sub_window = self.create_subscription(
                KeypointsWindow, '/lstm/keypoints_window', self.on_keypoints_window, 10
            )
        else:
            self.sub_window = None
            self.get_logger().warn("amr_interfaces/KeypointsWindow not found; will rely on /features_84 if available.")

        # Optional fallback: per-frame features (keep off-path but harmless)
        self.sub_frame = self.create_subscription(Float32MultiArray, '/features_84', self.on_features_frame, 10
        )

        # rolling buffer if we receive per-frame 84D features
        self.window = []

    # ---------- IO helpers ----------
    def _load_labels(self, path: str):
        if not path:
            return []
        try:
            with open(path, 'r') as f:
                return [ln.strip() for ln in f if ln.strip()]
        except Exception as e:
            self.get_logger().warn(f"Could not load labels from {path}: {e}")
            return []

    def _load_normalizer(self, path: str):
        try:
            import json
            with open(path, 'r') as f:
                j = json.load(f)
            mu    = np.array(j.get('mu', []), dtype=np.float32) if 'mu' in j else None
            sigma = np.array(j.get('sigma', []), dtype=np.float32) if 'sigma' in j else None
            return mu, sigma
        except Exception as e:
            self.get_logger().warn(f"No/invalid normalizer at {path}: {e}")
            return None, None

    def _normalize(self, x: np.ndarray) -> np.ndarray:
        if self.mu is not None and self.sigma is not None and self.mu.size == x.size == self.sigma.size:
            s = np.where(self.sigma == 0, 1.0, self.sigma)
            return (x - self.mu) / s
        return x

    # ---------- Subscribers ----------
    def on_keypoints_window(self, msg):
        """
        Accept common KeypointsWindow layouts:
        - msg.data: flat list length == T*F
        - msg.frames: list of Float32MultiArray (each 84D)
        """
        try:
            T = self.frames_needed
            F = 84 if (self.input_rank == 3 and self.feat_dim is None) else (self.feat_dim or 84)

            # case A: flat 'data'
            if hasattr(msg, 'data') and isinstance(msg.data, (list, tuple)):
                arr = np.asarray(msg.data, dtype=np.float32).ravel()
                if self.input_rank == 3 and arr.size == T * F:
                    x = arr.reshape(1, T, F)
                elif self.input_rank == 2 and arr.size == T * 84:
                    x = arr.reshape(1, -1)  # 2520 flat
                else:
                    self.get_logger().warn(f"KeypointsWindow.data unexpected size {arr.size}")
                    return
            # case B: list of frames
            elif hasattr(msg, 'frames'):
                frames = []
                for fr in msg.frames:
                    if hasattr(fr, 'data'):
                        f = np.asarray(fr.data, dtype=np.float32).ravel()
                        if f.size in (84, 63):  # 21*4 or 21*3 depending on features
                            frames.append(f)
                if not frames:
                    return
                seq = np.stack(frames, axis=0)  # (t, F)
                # pad/crop to T
                if seq.shape[0] < T:
                    pad = np.zeros((T - seq.shape[0], seq.shape[1]), dtype=np.float32)
                    seq = np.concatenate([pad, seq], axis=0)
                elif seq.shape[0] > T:
                    seq = seq[-T:]
                if self.input_rank == 3:
                    x = seq.reshape(1, T, seq.shape[1])
                else:
                    x = seq.reshape(1, -1)  # flatten
            else:
                self.get_logger().warn("KeypointsWindow has no data/frames; ignoring")
                return

            self._infer_and_publish(x)

        except Exception as e:
            self.get_logger().error(f"Failed to parse /lstm/keypoints_window: {e}")

    def on_features_frame(self, msg: Float32MultiArray):
        """Optional fallback: accumulate per-frame 84D into our window."""
        arr = np.asarray(msg.data, dtype=np.float32).ravel()
        if arr.size not in (84, 63):
            return
        self.window.append(arr.copy())
        if len(self.window) > self.frames_needed:
            self.window.pop(0)
        if len(self.window) < max(self.min_frames, self.frames_needed):
            return
        seq = np.array(self.window[-self.frames_needed:], dtype=np.float32)  # (T,F)
        if self.input_rank == 3:
            x = seq.reshape(1, self.frames_needed, -1)
        else:
            x = seq.reshape(1, -1)
        self._infer_and_publish(x)

    # ---------- Inference ----------
    def _infer_and_publish(self, x: np.ndarray):
        if self.session is None:
            self._publish_unknown("onnx_stub")
            return

        x = self._normalize(x.astype(np.float32))
        try:
            out = self.session.run(None, {self.session.get_inputs()[0].name: x})[0]  # (1, C)
            logits = out[0]
            probs = self._softmax(logits)
            cls_idx = int(np.argmax(probs))
            conf = float(probs[cls_idx])
            label = self.labels[cls_idx] if 0 <= cls_idx < len(self.labels) else f"class_{cls_idx}"

            if (self.bg_is_unknown and label == self.bg_label) or conf < self.conf_threshold:
                self._publish_unknown("low_conf", conf)
            else:
                msg_out = Intent()
                msg_out.label = label
                msg_out.confidence = conf
                msg_out.ts_unix = time.time()
                # publish to BOTH topics per pipeline contract
                self.pub_intent_raw.publish(msg_out)
                self.pub_intent_main.publish(msg_out)
        except Exception as e:
            self.get_logger().error(f"ONNX inference failed: {e}")
            self._publish_unknown("onnx_error")

    @staticmethod
    def _softmax(z):
        z = z - np.max(z)
        exp = np.exp(z)
        return exp / np.sum(exp)

    def _publish_unknown(self, reason: str, conf: float = 0.0):
        m = UnknownGesture()
        m.reason = reason
        m.confidence = conf
        m.ts_unix = time.time()
        self.pub_unknown.publish(m)

    def on_window(self, msg: KeypointsWindow):
        import numpy as np, time
        if self.session is None:
            self._publish_unknown("onnx_stub"); return
        try:
            T_msg = int(getattr(msg, "frames", 0) or 0)
            J = int(getattr(msg, "joints_per_frame", 0) or 0)
            F_msg = 3 * J if J > 0 else 0  # x,y,z per joint
            data = np.asarray(msg.data, dtype=np.float32).ravel()

            # infer F if needed
            if F_msg == 0 and T_msg > 0 and data.size % T_msg == 0:
                F_msg = data.size // T_msg
            if T_msg <= 0 or F_msg <= 0 or data.size != T_msg * F_msg:
                raise ValueError(f"bad window: T={T_msg}, F={F_msg}, len(data)={data.size}")

            # reshape last self.frames_needed frames -> (T,F)
            T = self.frames_needed
            F_model = self.feat_dim or F_msg
            seq = np.zeros((T, F_msg), dtype=np.float32)
            seq[-min(T_msg, T):] = data.reshape(T_msg, F_msg)[-T:]

            # adapt to model F (pad/truncate)
            if F_msg != F_model:
                if F_msg < F_model:
                    pad = np.zeros((T, F_model - F_msg), dtype=np.float32)
                    seq = np.concatenate([seq, pad], axis=1)
                else:
                    seq = seq[:, :F_model]

            x = seq.reshape(1, T, F_model).astype(np.float32)
            x = self._normalize(x)
            out = self.session.run(None, {self.session.get_inputs()[0].name: x})[0]
            logits = out[0]; probs = self._softmax(logits)
            cls = int(np.argmax(probs)); conf = float(probs[cls])
            label = self.labels[cls] if 0 <= cls < len(self.labels) else f"class_{cls}"
            if (self.bg_is_unknown and label == self.bg_label) or conf < self.conf_threshold:
                self._publish_unknown("low_conf", conf)
            else:
                m = Intent(); m.label = label; m.confidence = conf; m.ts_unix = time.time()
                self.pub_intent.publish(m)
        except Exception as e:
            self.get_logger().error(f"Failed to parse /lstm/keypoints_window: {e}")
            self._publish_unknown("parse_error")
    

def main():
    rclpy.init()
    node = LstmOnnxNode()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
