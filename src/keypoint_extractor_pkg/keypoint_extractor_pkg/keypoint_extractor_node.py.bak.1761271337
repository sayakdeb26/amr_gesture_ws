#!/usr/bin/env python3
import os, cv2, numpy as np
from collections import deque

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile
from cv_bridge import CvBridge
from sensor_msgs.msg import Image

from amr_interfaces.msg import UnknownGesture, KeypointsWindow

# ---- MediaPipe Tasks (GPU delegate) ----
import mediapipe as mp
from mediapipe.tasks.python import vision
from mediapipe.tasks.python.vision import HandLandmarker, HandLandmarkerOptions
from mediapipe.tasks.python.core import BaseOptions
from mediapipe.tasks.python.core import core

WINDOW = 30  # T

class KeypointExtractorNode(Node):
    def __init__(self):
        super().__init__('keypoint_extractor_node')

        # params
        self.declare_parameter('source', 'ros')
        self.declare_parameter('image_topic', '/image_raw')
        self.declare_parameter('stride', 1)
        self.declare_parameter('debug', True)
        self.declare_parameter('publish_annotated', True)
        self.declare_parameter('annotated_topic', '/keypoints_annotated')

        self.source_mode  = self.get_parameter('source').get_parameter_value().string_value
        self.image_topic  = self.get_parameter('image_topic').get_parameter_value().string_value
        self.stride       = int(self.get_parameter('stride').value)
        self.debug        = bool(self.get_parameter('debug').value)
        self.pub_anno     = bool(self.get_parameter('publish_annotated').value)
        self.anno_topic   = self.get_parameter('annotated_topic').get_parameter_value().string_value

        qos = QoSProfile(depth=10)
        self.pub_kp = self.create_publisher(KeypointsWindow, '/lstm/keypoints_window', qos)
        self.pub_img = self.create_publisher(Image, self.anno_topic, qos) if self.pub_anno else None

        self.bridge = CvBridge()

        # ---- create GPU hand landmarker ----
        model_asset = None  # use built-in model if None (bundled in mediapipe>=0.10.15)
        base = BaseOptions(model_asset_path=model_asset, delegate=core.Delegate.GPU)  # <- GPU
        opts = HandLandmarkerOptions(base_options=base,
                                     num_hands=2,
                                     running_mode=vision.RunningMode.IMAGE)
        self.landmarker: HandLandmarker = HandLandmarker.create_from_options(opts)
        self.get_logger().info("HandLandmarker created with delegate=GPU")

        # drawing utils
        self.mp_draw = mp.solutions.drawing_utils
        self.draw_spec = self.mp_draw.DrawingSpec(thickness=2, circle_radius=2)

        # buffers
        self.buf = deque(maxlen=WINDOW)
        self.frame_idx = 0

        # subscribe to ROS images
        self.sub = self.create_subscription(Image, self.image_topic, self.on_ros_image, qos)
        self.get_logger().info(f"keypoint_extractor_node up. mode=ros:{self.image_topic}, stride={self.stride}, debug={self.debug}")

    def _extract_pts(self, bgr):
        # MediaPipe Image wants SRGB
        rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
        mp_image = mp.Image(image_format=mp.ImageFormat.SRGB, data=rgb)
        res = self.landmarker.detect(mp_image)

        pts = []
        n = 0
        if res and res.hand_landmarks:
            n = len(res.hand_landmarks)
            for hand in res.hand_landmarks:
                # hand = list of 21 landmarks with x,y,z normalized
                for lm in hand:
                    pts.extend([float(lm.x), float(lm.y), float(lm.z)])
        # pad to exactly 2 hands worth of landmarks to keep J constant (21*3 per hand)
        if n == 1:
            pts.extend([0.0] * (21*3))
        return pts, res

    def _publish_buf(self, flat, joints_per_frame, source):
        msg = KeypointsWindow()
        msg.stamp = self.get_clock().now().to_msg()
        msg.frames = WINDOW
        msg.joints_per_frame = int(joints_per_frame)  # 42 (21*2 hands)
        msg.data = flat       # flat float32 list length = T * (J*C) = 30 * (42*3?) here we send 84 (x,y only) or 126 (x,y,z)
        msg.source = source
        self.pub_kp.publish(msg)

    def _annotate_and_publish(self, bgr, res):
        if not self.pub_img or not res or not res.hand_landmarks:
            return
        # draw using drawing_utils (expects NormalizedLandmarkList)
        h, w = bgr.shape[:2]
        for hand in res.hand_landmarks:
            # convert to solutions NormalizedLandmarkList to reuse drawer
            nls = mp.framework.formats.landmark_pb2.NormalizedLandmarkList()
            for lm in hand:
                nls.landmark.add(x=lm.x, y=lm.y, z=lm.z)
            self.mp_draw.draw_landmarks(
                bgr, nls, mp.solutions.hands.HAND_CONNECTIONS,
                self.draw_spec, self.draw_spec
            )
        self.pub_img.publish(self.bridge.cv2_to_imgmsg(bgr, encoding='bgr8'))

    def on_ros_image(self, msg: Image):
        try:
            bgr = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
        except Exception as e:
            self.get_logger().warn(f'cv_bridge convert failed: {e}')
            return

        pts, res = self._extract_pts(bgr)
        self._annotate_and_publish(bgr.copy(), res)

        if pts:
            self.buf.append(np.asarray(pts, dtype=np.float32))
            self.frame_idx += 1
            if len(self.buf) == WINDOW and (self.frame_idx % max(self.stride, 1) == 0):
                # Build fixed (T,F) window as x,y only (84) to match your LSTM 30x84 model
                T, F = 30, 84  # 42 joints * 2 coords
                recent = [x for x in list(self.buf)[-T:]]
                # we currently send x,y only; drop z (every 3rd)
                recent = [r.reshape(-1,3)[:42,:2].reshape(-1) if r.size>=126 else r[:84] for r in recent]
                win = np.zeros((T, F), dtype=np.float32)
                if recent:
                    m = min(len(recent), T)
                    win[-m:] = np.stack(recent[-m:], axis=0)
                flat = win.ravel().tolist()
                self._publish_buf(flat, joints_per_frame=42, source='mediapipe-tasks-gpu')

def main():
    rclpy.init()
    node = KeypointExtractorNode()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()
