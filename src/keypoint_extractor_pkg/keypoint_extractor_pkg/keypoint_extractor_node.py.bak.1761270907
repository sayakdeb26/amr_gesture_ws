#!/usr/bin/env python3
import os
import cv2
import numpy as np
from collections import deque

import rclpy
from rclpy.node import Node
from rclpy.qos import QoSProfile

from amr_interfaces.msg import UnknownGesture, KeypointsWindow
import mediapipe as mp
# --- request GPU delegate if available ---
try:
    from mediapipe.python._framework_bindings import gpu_service
    gpu_service.set_use_gpu(True)
    GPU_NOTE = 'MediaPipe: GPU delegate requested'
except Exception as _e:
    GPU_NOTE = f'MediaPipe GPU not available (fallback to CPU): {_e}'

WINDOW = 30          # frames per window
J_2HANDS = 42        # 21 joints/hand * 2 hands
F_2D = J_2HANDS * 2  # x,y → 84

class KeypointExtractorNode(Node):
    def __init__(self):
        super().__init__('keypoint_extractor_node')

        # ---------- parameters ----------
        self.declare_parameter('source', 'ros')                   # 'ros' | 'webcam' | 'clip'
        self.declare_parameter('image_topic', '/image_raw_10hz')  # used when source=ros
        self.declare_parameter('webcam_index', 0)
        self.declare_parameter('stride', 3)                       # publish every N frames
        self.declare_parameter('debug', False)                    # OpenCV overlay preview
        self.declare_parameter('debug_stride', 3)                 # draw every Nth frame

        self.source_mode   = self.get_parameter('source').get_parameter_value().string_value
        self.image_topic   = self.get_parameter('image_topic').get_parameter_value().string_value
        self.webcam_index  = int(self.get_parameter('webcam_index').value)
        self.stride        = int(self.get_parameter('stride').value)
        self.debug         = bool(self.get_parameter('debug').value)
        self.debug_stride  = int(self.get_parameter('debug_stride').value)

        # optional test clip (used when source=clip)
        self.test_clip = os.environ.get('PERCEPTION_TEST_CLIP', '').strip()

        qos = QoSProfile(depth=10)
        self.pub_kp = self.create_publisher(KeypointsWindow, '/lstm/keypoints_window', qos)

        # Mediapipe Hands
        self.hands = mp.solutions.hands.Hands(
            static_image_mode=False,
            max_num_hands=1,
            min_detection_confidence=0.5
        )
        self.mp_draw = mp.solutions.drawing_utils
        self.draw_spec = self.mp_draw.DrawingSpec(thickness=2, circle_radius=2)

        # buffering
        self.buf = deque(maxlen=WINDOW)   # holds per-frame 2D(84) vectors
        self.frame_idx = 0
        self.debug_idx = 0

        # mode routing
        if self.source_mode == 'ros':
            from cv_bridge import CvBridge
            from sensor_msgs.msg import Image
            self.bridge = CvBridge()
            self.sub = self.create_subscription(Image, self.image_topic, self.on_ros_image, qos)
            mode = f'ros:{self.image_topic}'
        elif self.source_mode == 'webcam':
            self.cap = cv2.VideoCapture(self.webcam_index)
            if not self.cap.isOpened():
                self.get_logger().warn('Webcam open failed.')
                self.cap = None
            self.timer = self.create_timer(0.0, self.tick_webcam)
            mode = f'webcam:{self.webcam_index}'
        elif self.source_mode == 'clip':
            if not self.test_clip:
                self.get_logger().warn('source=clip but PERCEPTION_TEST_CLIP is empty.')
            self.sub_unknown = self.create_subscription(UnknownGesture, '/lstm/unknown', self.on_unknown, qos)
            mode = f'clip:{self.test_clip if self.test_clip else "<none>"}'
        else:
            mode = f'unknown({self.source_mode})'
            self.get_logger().warn(f'Unknown source mode: {self.source_mode}')

        self.get_logger().info(
            f'keypoint_extractor_node up. mode={mode}, stride={self.stride}, debug={self.debug}'
        )
        try:
            self.get_logger().info(GPU_NOTE)
        except Exception:
            pass

    # ---------- helpers ----------
    def _extract_pts_xyz_twice(self, bgr):
        """
        Returns a flat list of x,y,z for detected hands.
        If only one hand is detected, pad with 63 zeros (21*3) to make two hands.
        Output length: 126 (2 hands * 21 joints * 3 coords).
        """
        rgb = cv2.cvtColor(bgr, cv2.COLOR_BGR2RGB)
        res = self.hands.process(rgb)

        pts_xyz = []
        n_hands = 0
        if res.multi_hand_landmarks:
            n_hands = len(res.multi_hand_landmarks)
            for hand in res.multi_hand_landmarks:
                for lm in hand.landmark:
                    pts_xyz.extend([float(lm.x), float(lm.y), float(lm.z)])

        if n_hands == 1:
            pts_xyz.extend([0.0] * 63)  # pad to two hands (x,y,z per joint)

        # if no hands, return empty (caller will skip appending to window)
        if n_hands == 0:
            return [], res

        # when two hands detected: ensure exactly 126 values
        if len(pts_xyz) > 126:
            pts_xyz = pts_xyz[:126]
        elif len(pts_xyz) < 126:
            pts_xyz.extend([0.0] * (126 - len(pts_xyz)))

        return pts_xyz, res

    def _xyz_to_xy84(self, pts_xyz):
        """
        Convert a 126-length [x,y,z]*42 vector to 84-length [x,y]*42.
        """
        a = np.asarray(pts_xyz, dtype=np.float32).reshape(-1, 3)  # (42,3)
        xy = a[:, :2].reshape(-1)                                # (84,)
        return xy

    def _maybe_debug(self, bgr, res):
        if not self.debug:
            return
        self.debug_idx += 1
        if self.debug_idx % max(self.debug_stride, 1) != 0:
            return
        try:
            if res and res.multi_hand_landmarks:
                for hand in res.multi_hand_landmarks:
                    self.mp_draw.draw_landmarks(
                        bgr, hand, mp.solutions.hands.HAND_CONNECTIONS,
                        self.draw_spec, self.draw_spec
                    )
            cv2.imshow('Keypoints Debug', bgr)
            if cv2.waitKey(1) & 0xFF == ord('q'):
                self.debug = False
                cv2.destroyWindow('Keypoints Debug')
        except cv2.error:
            pass  # headless / wayland: ignore

    def _maybe_publish_window(self, source_tag):
        """
        If we have WINDOW frames buffered, publish a KeypointsWindow with:
        - frames = 30
        - joints_per_frame = 42
        - data length = 30*84
        """
        if len(self.buf) < WINDOW:
            return

        if (self.frame_idx % max(self.stride, 1)) != 0:
            return

        T, F = WINDOW, F_2D
        recent = np.stack(list(self.buf)[-T:], axis=0)  # (T,84)
        # left pad if buffer was not full for some reason (defensive)
        if recent.shape[0] < T:
            pad = np.zeros((T - recent.shape[0], F), dtype=np.float32)
            win = np.concatenate([pad, recent], axis=0)
        else:
            win = recent.astype(np.float32, copy=False)

        msg = KeypointsWindow()
        msg.stamp = self.get_clock().now().to_msg()
        msg.frames = T
        msg.joints_per_frame = J_2HANDS          # <-- 42 (fixed, matches 84=42*2)
        msg.data = win.reshape(T * F).tolist()
        msg.source = source_tag
        self.pub_kp.publish(msg)

    # ---------- ROS image mode ----------
    def on_ros_image(self, msg):
        try:
            bgr = self.bridge.imgmsg_to_cv2(msg, desired_encoding='bgr8')
        except Exception as e:
            self.get_logger().warn(f'cv_bridge convert failed: {e}')
            return

        pts_xyz, res = self._extract_pts_xyz_twice(bgr)
        self._maybe_debug(bgr.copy(), res)

        if pts_xyz:
            xy84 = self._xyz_to_xy84(pts_xyz)  # (84,)
            self.buf.append(xy84)
            self.frame_idx += 1
            self._maybe_publish_window('mediapipe-ros')

    # ---------- webcam mode ----------
    def tick_webcam(self):
        if not hasattr(self, 'cap') or self.cap is None:
            return
        ok, frame = self.cap.read()
        if not ok:
            return

        pts_xyz, res = self._extract_pts_xyz_twice(frame)
        self._maybe_debug(frame.copy(), res)

        if pts_xyz:
            xy84 = self._xyz_to_xy84(pts_xyz)
            self.buf.append(xy84)
            self.frame_idx += 1
            self._maybe_publish_window('mediapipe-live')

    # ---------- clip mode ----------
    def on_unknown(self, _: UnknownGesture):
        if not self.test_clip or not os.path.isfile(self.test_clip):
            self.get_logger().warn('No valid PERCEPTION_TEST_CLIP; skip.')
            return

        cap = cv2.VideoCapture(self.test_clip)
        local = deque(maxlen=WINDOW)
        while len(local) < WINDOW:
            ok, frame = cap.read()
            if not ok:
                break
            pts_xyz, res = self._extract_pts_xyz_twice(frame)
            self._maybe_debug(frame.copy(), res)
            if pts_xyz:
                local.append(self._xyz_to_xy84(pts_xyz))
        cap.release()

        if len(local) == 0:
            self.get_logger().warn('No keypoints extracted.')
            return

        # construct window (left-pad zeros)
        T, F = WINDOW, F_2D
        win = np.zeros((T, F), dtype=np.float32)
        arr = np.stack(list(local), axis=0) if len(local) > 0 else np.zeros((0, F), dtype=np.float32)
        win[-arr.shape[0]:] = arr

        msg = KeypointsWindow()
        msg.stamp = self.get_clock().now().to_msg()
        msg.frames = T
        msg.joints_per_frame = J_2HANDS
        msg.data = win.reshape(T * F).tolist()
        msg.source = 'mediapipe-clip'
        self.pub_kp.publish(msg)
        self.get_logger().info(f'Published /lstm/keypoints_window frames={T} joints/frame={J_2HANDS}')

    # cleanup
    def destroy_node(self):
        try:
            cv2.destroyAllWindows()
        except cv2.error:
            pass
        super().destroy_node()

def main():
    rclpy.init()
    node = KeypointExtractorNode()
    rclpy.spin(node)
    node.destroy_node()
    rclpy.shutdown()

if __name__ == '__main__':
    main()

